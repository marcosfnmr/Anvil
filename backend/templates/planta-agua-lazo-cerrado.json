{
  "name": "Planta de agua · Lazo hidráulico",
  "network": {"subnet": "172.30.241.0/24"},
  "devices": [
    {
      "node_id": "plc-water",
      "device_type": "plc-s7",
      "name": "PLC de nivel y bombeo",
      "ip": "172.30.241.10",
      "config": {
        "scan_cycle_ms": 250,
        "components": [
          {"type": "io_channel", "channel_id": "level-ai", "name": "Nivel del depósito", "direction": "input", "data_type": "REAL", "unit": "%"},
          {"type": "io_channel", "channel_id": "pump-do", "name": "Orden de bomba", "direction": "output", "data_type": "BOOL"},
          {"type": "io_channel", "channel_id": "inlet-do", "name": "Orden de válvula de llenado", "direction": "output", "data_type": "BOOL"},
          {"type": "io_channel", "channel_id": "drain-do", "name": "Orden manual de vaciado", "direction": "output", "data_type": "BOOL"}
        ],
        "control_rules": [
          {"name": "Control de bombeo", "input_component": "Nivel del depósito", "output_component": "Orden de bomba", "mode": "below", "setpoint": 45, "hysteresis": 5},
          {"name": "Control de válvula de llenado", "input_component": "Nivel del depósito", "output_component": "Orden de válvula de llenado", "mode": "below", "setpoint": 45, "hysteresis": 5}
        ]
      }
    },
    {
      "node_id": "modbus-water",
      "device_type": "modbus-tcp",
      "name": "E/S Modbus de dosificación",
      "ip": "172.30.241.11",
      "config": {
        "unit_id": 1,
        "port": 502,
        "points": [
          {"type": "coil", "name": "Permiso remoto", "initial_value": false},
          {"type": "holding_register", "name": "Lote", "initial_value": 1},
          {"type": "input_register", "name": "Caudal indicado", "initial_value": 0, "unit": "L/min"}
        ]
      }
    },
    {
      "node_id": "hmi-water",
      "device_type": "hmi",
      "name": "HMI de operador",
      "ip": "172.30.241.12",
      "config": {"role": "hmi", "summary": "Operación y monitorización de S7/Modbus", "target_node_ids": "plc-water,modbus-water"}
    },
    {
      "node_id": "scada-water",
      "device_type": "scada",
      "name": "SCADA de planta",
      "ip": "172.30.241.13",
      "config": {
        "target_node_ids": "plc-water,modbus-water",
        "poll_interval_ms": 500,
        "history_capacity": 300,
        "alarms": [{"target_node_id": "plc-water", "address": "DB1.DBD0", "below": 20, "above": 90}]
      }
    }
  ],
  "field_objects": [
    {"object_id": "pump-feed", "type": "pump", "name": "Bomba de alimentación", "position": {"x": 80, "y": 140}, "response_seconds": 0, "flow_min": 90, "flow_max": 110, "unit": "L/min"},
    {"object_id": "tank-main", "type": "tank", "name": "Depósito principal", "position": {"x": 460, "y": 240}, "capacity_liters": 100, "initial_level_liters": 30, "outlet_flow_lpm": 50},
    {"object_id": "valve-inlet", "type": "valve", "name": "Válvula de llenado", "position": {"x": 280, "y": 140}, "response_seconds": 0, "flow_rate_lpm": 100},
    {"object_id": "valve-drain", "type": "valve", "name": "Válvula de vaciado", "position": {"x": 680, "y": 400}, "response_seconds": 0, "flow_rate_lpm": 50},
    {"object_id": "sensor-level", "type": "analog_sensor", "name": "Transmisor de nivel", "position": {"x": 460, "y": 90}, "unit": "%", "min_value": 0, "max_value": 100, "simulation": {"mode": "process"}}
  ],
  "signal_connections": [
    {"connection_id": "cmd-pump", "source": {"kind": "device", "node_id": "plc-water", "address": "DB1.DBX4.0", "channel_id": "pump-do"}, "target": {"kind": "field", "object_id": "pump-feed", "port": "command"}},
    {"connection_id": "cmd-inlet", "source": {"kind": "device", "node_id": "plc-water", "address": "DB1.DBX5.0", "channel_id": "inlet-do"}, "target": {"kind": "field", "object_id": "valve-inlet", "port": "command"}},
    {"connection_id": "cmd-drain", "source": {"kind": "device", "node_id": "plc-water", "address": "DB1.DBX6.0", "channel_id": "drain-do"}, "target": {"kind": "field", "object_id": "valve-drain", "port": "command"}},
    {"connection_id": "ai-level", "source": {"kind": "field", "object_id": "sensor-level", "port": "value"}, "target": {"kind": "device", "node_id": "plc-water", "address": "DB1.DBD0", "channel_id": "level-ai"}}
  ],
  "process_connections": [
    {"connection_id": "pump-to-inlet", "source": {"object_id": "pump-feed", "port": "flow"}, "target": {"object_id": "valve-inlet", "port": "process_in"}},
    {"connection_id": "inlet-to-tank", "source": {"object_id": "valve-inlet", "port": "process_out"}, "target": {"object_id": "tank-main", "port": "inlet"}},
    {"connection_id": "tank-to-drain", "source": {"object_id": "tank-main", "port": "outlet"}, "target": {"object_id": "valve-drain", "port": "process_in"}},
    {"connection_id": "tank-to-sensor", "source": {"object_id": "tank-main", "port": "level"}, "target": {"object_id": "sensor-level", "port": "measurement"}}
  ]
}
