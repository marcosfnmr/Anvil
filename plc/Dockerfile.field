ARG FIELD_BASE_IMAGE=docker.io/library/python:3.11-slim@sha256:0dd364ba7e10242f07755449e3a3d0e35f9efd987952737b90def6709ab0c5ce
FROM ${FIELD_BASE_IMAGE}
WORKDIR /app
COPY field_server.py ./
HEALTHCHECK --interval=5s --timeout=4s --start-period=5s --retries=3 CMD ["python", "-c", "import json,urllib.request; d=json.load(urllib.request.urlopen('http://127.0.0.1:8765/capabilities',timeout=3)); assert d.get('contract')=='anvil-field-runtime' and d.get('contract_version')==1"]
CMD ["python", "field_server.py"]
